{
  "name": "ppob-web-app",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "predev": "npm run db:setup",
    "dev": "next dev",
    "prestart": "npm run db:setup",
    "build": "next build",
    "start": "next start",
    "worker:payments": "node --env-file=.env scripts/payment-reconciler.mjs",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test:integrations": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types --test tests/openwa-request.test.mjs tests/integration-settings-crypto.test.mjs tests/integration-settings-resolution.test.mjs",
    "test:digiflazz-sync": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types --test tests/digiflazz-product-sync.test.mjs tests/digiflazz-protocol.test.mjs",
    "test:database": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types --test tests/postgres-schema.test.mjs tests/database-connection-options.test.mjs tests/system-config.test.mjs",
    "test:payments": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types --test tests/deposit-validation.test.mjs tests/qrisly-protocol.test.mjs tests/order-lookup.test.mjs tests/flash-sale.test.mjs tests/legal-content.test.mjs tests/order-actions.test.mjs tests/recovery.test.mjs tests/synthetic-email.test.mjs tests/social-links.test.mjs tests/contact-message.test.mjs tests/voucher-core.test.mjs tests/tokovoucher-protocol.test.mjs tests/vendor-registry.test.mjs tests/vendor-status.test.mjs tests/product-bulk-status.test.mjs tests/provider-alias.test.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/migrate-local-db.mjs",
    "db:setup": "npm run db:migrate && npm run admin:bootstrap",
    "admin:bootstrap": "node scripts/bootstrap-admin.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@better-auth/drizzle-adapter": "^1.7.18",
    "@libsql/client": "^0.18.0",
    "@tailwindcss/postcss": "^4.3.5",
    "aws4fetch": "^1.0.20",
    "better-auth": "^1.7.18",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^0.454.0",
    "next": "^16.4.5",
    "postgres": "^4.1.1",
    "qrcode": "^1.5.4",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "redis": "^6.3.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@types/node": "^24.19.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.0",
    "postcss": "^8.4.47",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.6.3"
  }
}
