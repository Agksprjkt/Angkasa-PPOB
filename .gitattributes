# Keep shell scripts and Caddyfile LF-only. core.autocrlf=true would otherwise
# check them out with CRLF, and a CRLF shebang fails on Linux with
# "/bin/sh^M: bad interpreter".
*.sh text eol=lf
Caddyfile text eol=lf
*.sql text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Windows-only files may keep CRLF.
*.ps1 text eol=crlf
*.bat text eol=crlf
