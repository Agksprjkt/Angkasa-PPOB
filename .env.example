# Copy this file to .env. Keep .env private and never commit real credentials.
# Empty integration values let you configure integrations in the Admin dashboard.
# Any non-empty integration environment value overrides the dashboard value.

# Authentication and public backend URL
# Secret used to sign auth/session data and encrypt integration credentials.
# Generate a random secret for production:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Required for auth. Generate a unique value for each environment before startup.
BETTER_AUTH_SECRET=
# Public backend URL used for auth links, callbacks, and metadata.
BETTER_AUTH_URL=http://localhost:3000
# Comma-separated browser origins allowed to use backend authentication.
# Include the separate frontend clone when running it on port 3001.
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3001

# Local database (safe default for Windows development)
# Selects the database adapter: sqlite or postgres.
# When empty, the value saved in Admin > Pengaturan > Sistem is used (default sqlite).
DATABASE_PROVIDER=sqlite
# SQLite database file path (relative to the project root unless absolute).
SQLITE_DATABASE_PATH=.data/app.db
# Optional file containing "sqlite" or "postgres"; when configured, its value
# overrides DATABASE_PROVIDER. Do not change database mode on a live deployment.
DATABASE_MODE_FILE=
# System settings written from Admin > Pengaturan > Sistem (database, Redis,
# storage, storefront). Secrets inside it are encrypted with BETTER_AUTH_SECRET.
# Keep it on the persistent volume; never commit it.
SYSTEM_CONFIG_FILE=.data/system-config.json
# The built-in storefront switch lives in that file, not here: when it is off,
# every public page redirects to /admin/login while /api keeps serving external
# frontends.

# PostgreSQL / Docker Compose settings
# For a direct non-Docker connection, uncomment and edit DATABASE_PROVIDER and
# DATABASE_URL. If DATABASE_URL_FILE is set, it takes precedence over URL.
# DATABASE_PROVIDER=postgres
# DATABASE_URL=postgres://ppob:URL_ENCODED_PASSWORD@127.0.0.1:5432/ppob
# Direct PostgreSQL connection string; leave empty when using SQLite or a URL file.
DATABASE_URL=
# Optional path to a file containing the PostgreSQL connection string.
DATABASE_URL_FILE=
# Optional direct (non-pooled) URL used only for migrations. Neon needs this
# because PgBouncer transaction mode cannot run Drizzle migrations. Leave empty
# to use DATABASE_URL, or the Admin > Sistem Neon preset.
DATABASE_URL_DIRECT=
DATABASE_URL_DIRECT_FILE=
# Run pending migrations at process startup. Default true. Set to false for
# managed databases (e.g. Neon) and run `npm run db:migrate` as a deploy step.
DATABASE_MIGRATE_ON_STARTUP=
# Managed PostgreSQL example (Neon). The app disables prepared statements
# automatically for pooled endpoints whose hostname contains "-pooler".
# Use the pooled URL here and the direct URL only for migrations.
# Neon can also be configured from Admin > Pengaturan > Sistem: the preset sets
# SSL, keeps startup migrations off, and can fetch both URLs from the Neon API.
# DATABASE_PROVIDER=postgres
# DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/ppob?sslmode=require
# DATABASE_URL_DIRECT=postgresql://user:password@ep-xxx.region.aws.neon.tech/ppob?sslmode=require
# DATABASE_MIGRATE_ON_STARTUP=false
# Optional Neon API key (neon_...). Enables "Ambil URL dari Neon" and the usage
# card in Admin > Sistem. Stored encrypted when saved from the dashboard.
NEON_API_KEY=
# Database name and login role created by the PostgreSQL Compose service.
POSTGRES_DB=ppob
POSTGRES_USER=ppob
# Paths to Docker Compose secret files; create these files before starting it.
# The password in the database URL secret must match the Postgres password file.
DATABASE_URL_SECRET_FILE=./secrets/database_url
POSTGRES_PASSWORD_SECRET_FILE=./secrets/postgres_password
REDIS_PASSWORD_SECRET_FILE=./secrets/redis_password

# Published application image for VPS deployments.
# Replace the owner/repository with the GHCR package created by this GitHub repo.
# Pin a sha-<commit> tag for a controlled update; use latest only when intended.
APP_IMAGE=

# Public address Caddy serves. Use http://<ip> before a domain exists; switch to
# the bare hostname (no scheme) to enable automatic Let's Encrypt HTTPS.
# DNS must point at the VPS and ports 80/443 must be reachable.
PPOB_SITE_ADDRESS=
# Contact address for Let's Encrypt expiry notices; only used for HTTPS.
PPOB_ACME_EMAIL=

# Optional Redis connection for non-Compose setups. Compose supplies its own
# private-network URL and password file to the app.
# Redis connection URL; leave empty to disable Redis outside Compose.
REDIS_URL=
# Optional path to a file containing the Redis password.
REDIS_PASSWORD_FILE=

# WhatsApp OTP provider (choose one, or configure in the Admin dashboard)
# Fonnte example:
# WHATSAPP_PROVIDER=fonnte
# FONNTE_TOKEN=PASTE_YOUR_FONNTE_TOKEN_HERE
# Provider used to send OTP messages: fonnte or openwa.
WHATSAPP_PROVIDER=
# Fonnte API token; only needed when WHATSAPP_PROVIDER=fonnte.
FONNTE_TOKEN=
# OpenWA example. Use a private server and keep its API key secret.
# WHATSAPP_PROVIDER=openwa
# OPENWA_API_URL=http://localhost:2785
# OPENWA_API_KEY=PASTE_YOUR_OPENWA_API_KEY_HERE
# OPENWA_SESSION_ID=PASTE_YOUR_OPENWA_SESSION_ID_HERE
# OpenWA server origin; only needed when WHATSAPP_PROVIDER=openwa.
OPENWA_API_URL=
# OpenWA API key and paired WhatsApp session ID.
OPENWA_API_KEY=
OPENWA_SESSION_ID=

# Digiflazz product provider
# To pin sandbox settings through the environment, uncomment:
# DIGIFLAZZ_MODE=sandbox
# ENABLE_REAL_TRANSACTIONS=false
# Production template: replace both credentials with your approved live
# credentials before uncommenting. Real transactions can spend actual funds.
# DIGIFLAZZ_USERNAME=PASTE_YOUR_DIGIFLAZZ_USERNAME_HERE
# DIGIFLAZZ_API_KEY=PASTE_YOUR_DIGIFLAZZ_API_KEY_HERE
# DIGIFLAZZ_MODE=production
# ENABLE_REAL_TRANSACTIONS=true
# Digiflazz account username; keep empty to use Admin dashboard settings.
DIGIFLAZZ_USERNAME=
# Digiflazz API key; keep empty to use Admin dashboard settings.
DIGIFLAZZ_API_KEY=
# Provider environment: sandbox or production. Empty defaults to sandbox.
DIGIFLAZZ_MODE=
# Must be true in addition to production mode to allow real product orders.
ENABLE_REAL_TRANSACTIONS=
# Master switch per vendor. A disabled vendor rejects new orders but pending
# orders keep being settled by the webhook and reconciler.
# DIGIFLAZZ_ENABLED=false
DIGIFLAZZ_ENABLED=
# TokoVoucher ships disabled by default.
TOKOVOUCHER_ENABLED=
# Digiflazz webhook secret. Set the same value in the member panel under
# Atur Koneksi > API > Webhook, then point the webhook at
# https://<your-host>/api/digiflazz/webhook. Digiflazz signs the raw body with
# HMAC-SHA1 and sends it as `X-Hub-Signature: sha1=<hex>`; when this value is
# empty the endpoint answers 503 instead of trusting any caller.
DIGIFLAZZ_WEBHOOK_SECRET=

# Postpaid (pascabayar) bills are a separate switch per vendor: paying a real bill
# moves real money, so leave these false until the merchant account is approved
# for pascabayar. While false, /api/bills/inquiry answers 503.
DIGIFLAZZ_POSTPAID_ENABLED=
TOKOVOUCHER_POSTPAID_ENABLED=

# TokoVoucher product provider (second H2H partner)
# Credentials come from https://member.tokovoucher.net/pengaturan/secret-key
# Member code and secret; keep empty to use Admin dashboard settings.
TOKOVOUCHER_MEMBER_CODE=
TOKOVOUCHER_SECRET=
# The "signature default" value shown on that same page. Required by the
# /member and /member/produk/full endpoints. Leave empty to fall back to the
# secret, which is only correct if both values are identical in the panel.
TOKOVOUCHER_DEFAULT_SIGNATURE=
# sandbox or production. Empty defaults to sandbox.
TOKOVOUCHER_MODE=
# Separate from ENABLE_REAL_TRANSACTIONS so enabling one provider never turns on
# real spending for the other.
TOKOVOUCHER_ENABLE_REAL_TRANSACTIONS=
# Auto sync is OFF by default: synced products land inactive and stay hidden
# until an admin activates them.
# TOKOVOUCHER_AUTO_SYNC_ENABLED=false
TOKOVOUCHER_AUTO_SYNC_ENABLED=
TOKOVOUCHER_AUTO_SYNC_INTERVAL_DAYS=
# Shared token TokoVoucher sends as `X-TokoVoucher-Authorization` when calling
# https://<your-host>/api/tokovoucher/webhook. Empty answers 503.
TOKOVOUCHER_WEBHOOK_SECRET=

# Qrisly automatic QRIS payment gateway
# Sandbox template:
# QRISLY_MODE=sandbox
# QRISLY_ENABLED=false
# ACTIVE_PAYMENT_GATEWAY=none
# Production template: replace the credentials and verify the merchant QR
# before enabling live deposits/payments.
# QRISLY_API_KEY=PASTE_YOUR_QRISLY_API_KEY_HERE
# QRISLY_ID=PASTE_YOUR_QRISLY_MERCHANT_QRIS_ID_HERE
# QRISLY_MODE=production
# QRISLY_ENABLED=true
# ACTIVE_PAYMENT_GATEWAY=qrisly
# Qrisly API key and merchant QR ID; keep empty to use Admin settings.
QRISLY_API_KEY=
QRISLY_ID=
# Provider environment: sandbox or production. Empty defaults to sandbox.
QRISLY_MODE=
# Must be true to allow Qrisly to create automatic QRIS payments.
QRISLY_ENABLED=
# Selects the automatic payment gateway. Qrisly is the only implemented
# gateway; use none to disable it. DOKU, Midtrans, and Xendit are unavailable.
ACTIVE_PAYMENT_GATEWAY=

# Internal payment reconciliation worker (Docker Compose)
# Required secret: generate a unique random value of at least 32 bytes.
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# PAYMENT_RECONCILER_SECRET=PASTE_A_UNIQUE_RANDOM_SECRET_HERE
# Compose sets this internal URL automatically. For a local worker, use:
# PAYMENT_RECONCILER_URL=http://localhost:3000/api/internal/reconcile-payments
# Optional internal endpoint URL for the scheduled Digiflazz product sync.
# DIGIFLAZZ_SYNC_URL=http://localhost:3000/api/internal/digiflazz-product-sync
# Shared secret checked by the internal payment reconciliation endpoint.
PAYMENT_RECONCILER_SECRET=
# Qrisly payment webhook shared secret. Must be at least 32 bytes; when empty
# /api/payment-gateway/callback answers 503 instead of trusting any caller.
# The webhook payload is never trusted for payment status: the handler re-reads
# the payment from Qrisly and records the event id for replay protection.
QRISLY_WEBHOOK_SECRET=

# Optional environment overrides for the Digiflazz auto-sync dashboard setting.
# Leave empty to control the toggle and cadence from the admin dashboard.
DIGIFLAZZ_AUTO_SYNC_ENABLED=
DIGIFLAZZ_AUTO_SYNC_INTERVAL_DAYS=

# First-time admin creation only. Set true and fill these values only when
# bootstrapping a new database; turn it off immediately after creation.
# Set to true only for the initial admin bootstrap script.
BOOTSTRAP_ADMIN_ENABLED=false
# BOOTSTRAP_ADMIN_PHONE=+6281234567890
# BOOTSTRAP_ADMIN_NAME=Store Administrator
# BOOTSTRAP_ADMIN_PASSWORD=USE_A_UNIQUE_STRONG_PASSWORD
# Phone number, display name, and unique password for the initial admin.
BOOTSTRAP_ADMIN_PHONE=
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ADMIN_PASSWORD=

# The external frontend clone has its own .env.local file; configure its API
# origin there rather than adding frontend-specific variables to this backend.
# BACKEND_API_ORIGIN=http://localhost:3000

# VPS maintenance bot. Not read by the app; the backup, failure-notification,
# and daily-report scripts source secrets/backup.env instead. Keep the real
# values there (chmod 600, git-ignored) and leave these empty.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# TELEGRAM_RETENTION=30
