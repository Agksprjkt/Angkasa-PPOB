# Caddy reverse proxy for the PPOB app.
#
# PPOB_SITE_ADDRESS decides the scheme:
#   http://1.2.3.4   -> plain HTTP on port 80, no certificate (IP-only hosting)
#   example.com      -> automatic HTTPS with a Let's Encrypt certificate
# For HTTPS the DNS A record must already point here and ports 80/443 must be
# reachable from the internet.
#
# The app listens on 127.0.0.1:3000 on the host, but Caddy reaches it by service
# name over the Compose network, which keeps the app port unpublished.

{
	email {$PPOB_ACME_EMAIL}
	servers {
		protocols h1 h2
	}
}

{$PPOB_SITE_ADDRESS} {
	encode zstd gzip

	# No HSTS header here: next.config.mjs already sets it, and two copies of the
	# same header are invalid. Only strip the version banner.
	header {
		-Server
	}

	reverse_proxy app:3000 {
		# Preserve the client address so Better Auth records a real IP. The app
		# trusts these headers only through trustedProxies.
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto {scheme}
		header_up X-Real-IP {remote_host}
		health_uri /api/health
		health_status 200
		health_interval 30s
		health_timeout 5s
	}

	log {
		output stdout
		format console
	}
}
